module RF (
    clk: input clock,
    rst: input reset,

    we: input logic,

    rd: input bit<5>,
    wdata: input bit<32>,

    rs1: input bit<5>,
    rs2: input bit<5>,
    rdata1: output bit<32>,
    rdata2: output bit<32>,
) {
    always_ff {
        if_reset {} else {
            if we && rd != 0 {
                $sv::write_regfile(rd, wdata);
            }
        }
    }

    assign rdata1 = $sv::read_regfile(rs1);
    assign rdata2 = $sv::read_regfile(rs2);
}
