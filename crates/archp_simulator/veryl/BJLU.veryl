/// Branch + Jump + Link Unit
module BJLU (
    opcode: input bit<7>,
    funct3: input bit<3>,
    rd: input bit<5>,
    rs1: input bit<5>,
    imm12: input signed bit<12>,

    rdata1: input bit<32>,
    rdata2: input bit<32>,
    pc: input bit<32>,

    rfwe: output logic,
    wdata: output bit<32>,
    pcwe: output logic,
    pcwdata: output bit<32>,
) {
    let imm_branch: signed bit<32> = {rd[msb] repeat 19, rd, imm12[11:5], 1'b0};
    let pc_branch: bit<32> = pc + imm_branch;

    let imm_jal: signed bit<32> = {
        funct3[msb] repeat 11, funct3, rs1, imm12, 1'b0
    };
    let pc_jal: bit<32> = pc + imm_jal;

    let imm_jalr: signed bit<32> = {imm12[msb] repeat 20, imm12};
    let pc_jalr: bit<32> = (rdata1 + imm_jalr) & ~1;

    always_comb {
        rfwe = 0;
        wdata = '0;
        pcwe = 0;
        pcwdata = '0;

        if opcode == 'b0001001 {
            #[cond_type(unique)]
            case funct3 {
                'b000 /* BEQ */: {
                    pcwe = rdata1 == rdata2;
                    pcwdata = pc_branch;
                }
                'b001 /* BNE */: {
                    pcwe = rdata1 != rdata2;
                    pcwdata = pc_branch;
                }
                'b010 /* BLT */: {
                    pcwe = $signed(rdata1) <: $signed(rdata2);
                    pcwdata = pc_branch;
                }
                'b011 /* BGE */: {
                    pcwe = $signed(rdata1) >= $signed(rdata2);
                    pcwdata = pc_branch;
                }
                'b100 /* BLTU */: {
                    pcwe = rdata1 <: rdata2;
                    pcwdata = pc_branch;
                }
                'b101 /* BGEU */: {
                    pcwe = rdata1 >= rdata2;
                    pcwdata = pc_branch;
                }
                'b111 /* JALR */: {
                    pcwe = 1;
                    pcwdata = pc_jalr;
                    rfwe = 1;
                    wdata = pc + 4;
                }
                default: {}
            }
        } else if /* JAL */ opcode == 'b0001010 {
            pcwe = 1;
            pcwdata = pc_jal;
            rfwe = 1;
            wdata = pc + 4;
        }
    }
}
