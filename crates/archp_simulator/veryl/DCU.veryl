/// Display Control Unit
module DCU (
    clk: input clock,
    rst: input reset,

    opcode: input bit<7>,
    imm12: input signed bit<12>,

    rdata1: input bit<32>,
    rdata2: input bit<32>,

    rfwe: output logic,
    wdata: output bit<32>,
) {
    var color: bit<32>;

    var col: bit<32>;
    always_comb {
        col = $signed(rdata1) + $signed({imm12[msb] repeat 20, imm12});
    }

    always_ff {
        if_reset {
            color = '0;
            $sv::pixel_display_reset();
        } else if opcode == 'b1101_000 /* COL */ {
            color = col;
        } else if opcode == 'b1101_001 /* SPX */ {
            $sv::pixel_display_set(rdata1, rdata2, color);
        }
    }

    assign rfwe = opcode == 'b1101_000 /* COL */;
    assign wdata = if rfwe ? col : '0;
}
