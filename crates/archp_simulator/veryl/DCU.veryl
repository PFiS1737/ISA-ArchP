/// Display Control Unit
module DCU (
    clk: input clock,
    rst: input reset,

    opcode: input bit<7>,
    funct3: input bit<3>,
    imm12: input signed bit<12>,

    rdata1: input bit<32>,
    rdata2: input bit<32>,

    rfwe: output logic,
    wdata: output bit<32>,
) {
    let en: logic = opcode == 'b1111111;

    var color: bit<32>;

    let col: bit<32> = $signed(rdata1) + $signed({imm12[msb] repeat 20, imm12});

    always_ff {
        if_reset {
            color = '0;
        } else {
            if /* COLR */ en && funct3 == 'b000 {
                color = col;
            } else if /* SPX */ en && funct3 == 'b001 {
                $sv::pixel_display_set(rdata1, rdata2, color);
            }
        }
    }

    assign rfwe = /* COL */ en && funct3 == 'b000;
    assign wdata = if rfwe ? col : '0;
}
