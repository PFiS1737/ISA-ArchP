/// Input/Output Unit
module IOU (
    clk: input clock,
    rst: input reset,

    opcode: input bit<7>,
    funct3: input bit<3>,
    rdata1: input bit<32>,

    rfwe: output logic,
    wdata: output bit<32>,
) {
    let en: logic = opcode == 'b1111111;

    always_comb {
        rfwe = 0;
        wdata = '0;

        if en {
            case funct3 {
                'b010 /* IN */: {
                    rfwe = 1;
                    wdata = $sv::simple_input();
                }
                'b100 /* KBGET */: {
                    rfwe = 1;
                    wdata = $sv::keyboard_get();
                }
                'b101 /* RAND */: {
                    rfwe = 1;
                    wdata = $urandom();
                }
                default: {}
            }
        }
    }

    always_ff {
        if_reset {} else {
            if /* OUT */ en && funct3 == 'b011 {
                $sv::simple_output(rdata1);
            }
        }
    }
}
