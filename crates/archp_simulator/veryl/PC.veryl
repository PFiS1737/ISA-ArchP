module PC (
    clk: input clock,
    rst: input reset,

    we: input logic,
    wdata: input bit<32>,

    pc: output bit<32>,
) {
    var value: bit<32>;

    always_ff (clk) {
        if_reset {
            value = '0;
        } else {
            if (we) {
                value = wdata;
            } else {
                value += 4;
            }
        }
    }

    assign pc = value;
}
