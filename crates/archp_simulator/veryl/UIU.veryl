/// Upper Immediate Unit
module UIU (
    opcode: input bit<7>,
    funct3: input bit<3>,
    rs1: input bit<5>,
    imm12: input signed bit<12>,

    pc: input bit<32>,

    rfwe: output logic,
    wdata: output bit<32>,
) {
    let uimm: signed bit<32> = {funct3, rs1, imm12, 12'b0};

    always_comb {
        rfwe = 0;
        wdata = '0;

        if /* LUI */ opcode == 'b0001011 {
            rfwe = 1;
            wdata = uimm;
        } else if /* AUIPC */ opcode == 'b0001100 {
            rfwe = 1;
            wdata = pc + uimm;
        }
    }
}
